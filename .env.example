# ========== 停车楼系统环境变量示例 ==========
# 复制本文件为 .env 并按需修改（.env 已被 gitignore，不会提交到 GitHub）

# 运行环境：development（本地开发，SQLite 回退）/ production（在线部署，强制在线数据库）
APP_ENV=development

# 数据库连接串。production 环境必填；development 缺省回退 sqlite:///parking.db（instance 目录）
# PostgreSQL 示例（psycopg 3 驱动）：
# DATABASE_URL=postgresql+psycopg://用户名:密码@数据库地址:5432/数据库名
DATABASE_URL=

# Flask 密钥。production 环境必填，请用长随机字符串（如 Render 的 Generate 按钮生成）
SECRET_KEY=

# 允许的前端来源（逗号分隔）。production 环境必填，填 Netlify 前端域名
# CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=

# 监听端口（默认 5000；Render/Railway 会注入 PORT 覆盖）
PORT=5000
